# ============================================================
# Scholar Digest 配置文件
# 用于 Google Scholar 邮件论文摘要功能
#
# 使用方法: cp config/scholar.env.template config/scholar.env
# 注意: 嵌套配置使用双下划线分隔（如 LLM__GEMINI_API_KEY），
#       这是 pydantic-settings 的 env_nested_delimiter 约定。
# ============================================================

# ==================== Gmail API 配置 ====================
# OAuth 2.0 客户端凭据文件路径
# 从 Google Cloud Console 下载: https://console.cloud.google.com/
GMAIL__CREDENTIALS_PATH=config/credentials.json

# OAuth 2.0 令牌存储路径（首次认证后自动生成）
GMAIL__TOKEN_PATH=config/token.json

# ==================== LLM 配置 ====================
# LLM 提供商 (gemini, deepseek, openai-compatible)
LLM__PROVIDER=gemini

# Gemini API 密钥
# 获取地址: https://aistudio.google.com/apikey
LLM__GEMINI_API_KEY=your_gemini_api_key_here

# LLM 模型名称（gemini 用 gemini-*；deepseek 用 deepseek-v4-flash / deepseek-v4-pro）
LLM__MODEL=gemini-2.0-flash

# --- DeepSeek / OpenAI 兼容提供商（LLM__PROVIDER=deepseek 时使用）---
# 不设置时自动复用主配置 config/config.env 的 API__OPENAI_API_KEY / API__OPENAI_BASE_URL
# LLM__OPENAI_API_KEY=your_deepseek_api_key_here
# LLM__BASE_URL=https://api.deepseek.com/v1

# ==================== 处理配置 ====================
# 批量处理大小（每次发送给 LLM 的论文数量）
PROCESSING__BATCH_SIZE=5

# 最大处理邮件数量
PROCESSING__MAX_EMAILS=100

# 获取最近 N 天的邮件
PROCESSING__DAYS_TO_FETCH=7

# ==================== 输出配置 ====================
# 输出目录
PROCESSING__OUTPUT_DIR=output/scholar_digest

# ==================== 日志配置 ====================
# 日志级别 (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# 日志文件路径
LOG_FILE=logs/scholar_digest.log
