# ============================================================
# Scholar Digest 配置文件
# 用于 Google Scholar 邮件论文摘要功能
# ============================================================

# ==================== Gmail API 配置 ====================
# OAuth 2.0 客户端凭据文件路径
# 从 Google Cloud Console 下载: https://console.cloud.google.com/
GMAIL_CREDENTIALS_PATH=config/credentials.json

# OAuth 2.0 令牌存储路径（首次认证后自动生成）
GMAIL_TOKEN_PATH=config/token.json

# ==================== LLM 配置 ====================
# LLM 提供商 (gemini, openai-compatible)
LLM_PROVIDER=gemini

# Gemini API 密钥
# 获取地址: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# LLM 模型名称
LLM_MODEL=gemini-2.0-flash

# ==================== 处理配置 ====================
# 批量处理大小（每次发送给 LLM 的论文数量）
BATCH_SIZE=5

# 最大处理邮件数量
MAX_EMAILS=100

# 获取最近 N 天的邮件
DAYS_TO_FETCH=7

# ==================== 输出配置 ====================
# 输出目录
OUTPUT_DIR=output/scholar_digest

# ==================== 日志配置 ====================
# 日志级别 (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# 日志文件路径
LOG_FILE=logs/scholar_digest.log
