# ============================================================
# Scholar Digest 配置文件
# 用于 Google Scholar 邮件论文摘要功能
#
# 使用方法: cp config/scholar.env.template config/scholar.env
# 注意: 嵌套配置使用双下划线分隔（如 LLM__GEMINI_API_KEY），
#       这是 pydantic-settings 的 env_nested_delimiter 约定。
# ============================================================

# ==================== Gmail API 配置 ====================
# OAuth 2.0 客户端凭据文件路径
# 从 Google Cloud Console 下载: https://console.cloud.google.com/
GMAIL__CREDENTIALS_PATH=config/credentials.json

# OAuth 2.0 令牌存储路径（首次认证后自动生成）
GMAIL__TOKEN_PATH=config/token.json

# ==================== LLM 配置 ====================
# LLM 提供商 (gemini, deepseek, openai-compatible)
LLM__PROVIDER=deepseek
# 回退链（逗号分隔）：主 provider 欠费/认证失败/CLI 缺失/内容拦截时依序切换
# LLM__FALLBACK_PROVIDERS=ollama,claude-agent,gemini
# 本地 Ollama（链上使用；独立配置组）
# LLM__OLLAMA_BASE_URL=http://localhost:11434/v1
# LLM__OLLAMA_MODEL=qwen3.5:35b

# LLM 模型名称（deepseek 用 deepseek-v4-flash / deepseek-v4-pro；gemini 用 gemini-*）
LLM__MODEL=deepseek-v4-flash

# --- DeepSeek / OpenAI 兼容提供商密钥 ---
# 不设置时自动复用主配置 config/config.env 的 API__OPENAI_API_KEY / API__OPENAI_BASE_URL
# LLM__OPENAI_API_KEY=your_deepseek_api_key_here
# LLM__BASE_URL=https://api.deepseek.com/v1

# --- Gemini（LLM__PROVIDER=gemini 时使用）---
# 获取地址: https://aistudio.google.com/apikey
# LLM__GEMINI_API_KEY=your_gemini_api_key_here

# 白名单裁决专用模型（不设置时复用 LLM__MODEL；建议 flash 级，裁决成本极低）
# LLM__FILTER_MODEL=gemini-2.0-flash

# ==================== 过滤配置 ====================
# 白名单过滤模式：
#   llm     = 黑名单确定性预过滤 + LLM 相关性裁决（宽松语义匹配，默认）
#   keyword = 传统黑白名单关键词匹配
# 每次裁决（判定+理由+模型+prompt 版本）都会写入 {run_id}_excluded.json 供审计
# PROCESSING__FILTER_MODE=llm

# 论文主题与定位（注入 LLM 方法学审稿 prompt 的 {{RESEARCH_INTERESTS}}）
# filter-v3 是三态方法学审稿（INCLUDE/MAYBE/EXCLUDE + bucket/flags/role/one_line/confidence）
# 默认值单点化在 config/research_profile.yaml（interests 字段）——换研究方向改那一处即可，
# 无需碰这个 env 模板。这里的 env 覆盖优先级最高：env > research_profile.yaml > 内嵌默认，
# 仅用于「不改配置文件、临时覆盖一次」的场景（如本机调试）。
# PROCESSING__RESEARCH_INTERESTS=论文主题：EHR 缺失机制（MNAR）与「缺失条件依赖结构」的跨中心可迁移性...

# 黑白名单关键词（JSON 数组格式，pydantic-settings 对 List 字段的约定）
# 白名单仅 keyword 模式（及 LLM 失败回退时）生效；
# 黑名单为确定性预过滤，请保持保守——只放无歧义的完全离题词（天文/材料学等）。
# 不要把影像/基因/信号放进黑名单：X1..X7 交给 LLM 判定，否则会误杀对抗性证据（THREAT）。
# PROCESSING__WHITELIST=["EHR", "MNAR", "transportability", "GNN"]
# PROCESSING__BLACKLIST=["Astronomy", "Materials Science", "Geology"]

# ==================== 外部检索来源（PubMed / arXiv） ====================
# 并入每周 digest：除 Gmail Scholar Alert 外，按检索式抓 PubMed/arXiv，去重后一起筛选。
# 全部公开接口，无需密钥；--dry-run 下自动跳过网络请求。
# PROCESSING__EXTERNAL_SOURCES_ENABLED=true
# 每个来源最多抓取的论文数
# PROCESSING__EXTERNAL_MAX_RESULTS=25
# NCBI E-utilities 礼貌参数用的联系邮箱（可选）
# PROCESSING__EXTERNAL_EMAIL=you@example.com
# arXiv 检索式（Atom API 语法，字段前缀 all:/abs:）
# PROCESSING__ARXIV_QUERY=(all:MNAR OR all:"informative missingness") AND (all:EHR OR all:ICU)
# PubMed 检索式（E-utilities term 语法）
# PROCESSING__PUBMED_QUERY=(MNAR OR informative missingness) AND (EHR OR ICU OR clinical prediction)

# ==================== Zotero 联动（B1 全自动写库 + pandoc 札记） ====================
# digest 后把入选论文写入 Zotero（连接器 saveItems），由 Better BibTeX 分配 citekey，
# 再生成 pandoc-ready 科研札记（正文 [@citekey] + references.json）。
# 前提：Zotero 桌面端开着 + 已启用「允许本机其他应用通信」+ 安装 Better BibTeX。
# 默认关闭：无人值守 cron 下 Zotero 可能没开，建议交互式运行：
#   python scholar_main.py zotero --input output/scholar_digest/<run_id>.json
# 或 digest 时加 --zotero（人在时）。
# PROCESSING__ZOTERO_ENABLED=false
# Zotero 连接器服务地址（本地，一般不用改）
# PROCESSING__ZOTERO_BASE_URL=http://localhost:23119
# 防呆：要求写入的分类名。设了就必须在 Zotero 左栏选中同名分类，否则拒绝写入（避免落到库根 Unfiled）。
# PROCESSING__ZOTERO_COLLECTION=P4
# 是否解析 OA PDF（arXiv 直链 / Unpaywall）作为附件让 Zotero 自抓
# PROCESSING__ZOTERO_ATTACH_PDF=true
# 写库前用 Crossref 标题检索规范作者 + 补 DOI（修正 Scholar 邮件解析出的脏作者；标题相似度门槛防误配）
# PROCESSING__ZOTERO_ENRICH_CROSSREF=true
# Unpaywall 礼貌参数邮箱（联系句柄，非密钥）；为空时复用 EXTERNAL_EMAIL
# PROCESSING__ZOTERO_EMAIL=you@example.com
# pandoc 科研札记输出目录
# PROCESSING__NOTES_DIR=output/scholar_notes
# 自定义归纳指令（写入札记手记区注释，供你后续整理）
# PROCESSING__NOTES_INSTRUCTION=

# ==================== 处理配置 ====================
# 批量处理大小（每次发送给 LLM 的论文数量）
PROCESSING__BATCH_SIZE=5

# 最大处理邮件数量
PROCESSING__MAX_EMAILS=100

# 获取最近 N 天的邮件
PROCESSING__DAYS_TO_FETCH=7

# ==================== 输出配置 ====================
# 输出目录
PROCESSING__OUTPUT_DIR=output/scholar_digest

# ==================== 日志配置 ====================
# 日志级别 (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# 日志文件路径
LOG_FILE=logs/scholar_digest.log
