<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Scholar Digest 每周自动运行（launchd 用户代理）
  由 scripts/install_weekly_digest.sh 安装：占位符 __REPO_ROOT__ / __PYTHON_BIN__ /
  __LOG_DIR__ 会被替换为实际路径后拷入 ~/Library/LaunchAgents/。

  直接执行 python 而非 bash 包装脚本：仓库在 ~/Documents 下受 macOS TCC 保护，
  launchd 任务访问它需要在 系统设置 > 隐私与安全性 > 完全磁盘访问权限 中授权，
  直接执行 python 可把需授权的二进制收窄到一个（见 install 脚本输出的提示）。
  日志写到 ~/Library/Logs/（无 TCC 限制），避免 launchd 写日志本身被拒。

  相比 crontab 的优势：错过触发时点（睡眠/关机）唤醒后自动补跑。
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.xlbd.scholar-digest</string>

    <key>ProgramArguments</key>
    <array>
        <string>__PYTHON_BIN__</string>
        <string>scholar_main.py</string>
        <string>digest</string>
        <string>--days</string>
        <string>8</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <!-- ⚠️ 绕开本机代理：macOS 系统代理开着时（如 Clash 的 127.0.0.1:7890），
             httpx 经 urllib.request.getproxies() 读到系统设置，会把 http://localhost:11434
             也送进代理，Clash 对本地地址回 502 → 本机 Ollama 一律不可用。
             交互 shell 通常已有 no_proxy 所以手跑没事，launchd 干净环境没有，
             于是「手动能跑、定时永远挂」（curl 不读系统代理，用 curl 探活会误报健康）。
             本 job 会用到本地 Ollama：LLM__FALLBACK_PROVIDERS=ollama 的回退，
             以及 sync_store 的 bge-m3 嵌入。2026-08-16 实测并修。 -->
        <key>no_proxy</key>
        <string>localhost,127.0.0.1,::1</string>
        <key>NO_PROXY</key>
        <string>localhost,127.0.0.1,::1</string>
        <!-- ⚠️ launchd 默认 PATH 不含 /opt/homebrew/bin，claude CLI 在那里——
             缺了它 claude-agent provider 静默跳过、回退链落到 gemini 兜底
             （2026-08-31 周一 09:00 实跑抓到：交互 shell 探活正常、launchd 永远降级，
             与上面 no_proxy 是同一类「手动能跑、定时退化」坑）。
             另：claude CLI 的登录态还硬依赖 USER 变量（按 account=$USER 读 login
             Keychain 的凭据），launchd gui 域自动提供 HOME/USER/LOGNAME/TMPDIR，
             所以不用显式设；但迁 system domain 或裁剪 env 会以 loggedIn:false
             静默挂（2026-08-31 审计洁净环境二分实测）。 -->
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>WorkingDirectory</key>
    <string>__REPO_ROOT__</string>

    <!-- 每周一 09:00 -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>1</integer>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>__LOG_DIR__/cron_digest.log</string>
    <key>StandardErrorPath</key>
    <string>__LOG_DIR__/cron_digest.err.log</string>
</dict>
</plist>
