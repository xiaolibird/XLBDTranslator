<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  周 digest 自动筛选（2026-11-02 起取代原来的入库确认弹窗）：每天 10:00 同步待确认队列，
  由 LLM 按固定口径（src/scholar/auto_triage.py 的 CRITERIA：缺失机制方法 + ICU 现象/前沿做法 +
  处置混杂实例）逐篇研判，落盘决策后对相应自然周调 ingest_notes.py 入库+精读，
  最后发一条系统通知并写报告 output/scholar_notes/_pending/auto_triage_<日期>.md。
  不弹窗，不需要图形会话应答。

  失败语义：LLM 不可用/漏判的条目保持 pending（不是默认丢弃），第二天同一时间重试；
  标签来源记为 auto_agent，filter_eval / profile_drift 默认排除（不是人的判断）。
  想改回人工弹窗：把下面 ProgramArguments 的 auto_triage.py 换回 confirm_ingest.py 并加 daily 参数（见该脚本 -h），
  重新跑 scripts/install_confirm.sh；单次人工覆盖用 confirm_ingest.py 的 reopen 参数（见 -h）。

  保持 label 不变（com.xlbd.scholar-confirm）：沿用原来的安装/卸载入口与日志文件名。
  周度 ingest（com.xlbd.scholar-weekly-ingest，周一 09:30）不动：它过闸门只放行已决策的论文，
  是兜底的空跑。10:00 而非 09:15：digest 平均 6 分钟但长度浮动，stats.json 没生成的 run 次日再入队。
  每天同步后检查最近一个已越过周一 10:00 截止点的计划批次：跨日补跑仍覆盖刚过去的周一，
  同一批次只通知一次但持续非零退出，直到补齐。只接受 JSON/stats 均可解析、覆盖滚动近 ≥7 天的
  完整批次，历史回填不能冒充周批；也防止 digest 未启动/中途死掉时下游把空队列误报成正常。

  由 scripts/install_confirm.sh 安装：占位符 __REPO_ROOT__ / __PYTHON_BIN__ / __LOG_DIR__
  会被替换后拷入 ~/Library/LaunchAgents/。claude CLI 登录态依赖 launchd gui 域自带的 USER
  变量（见 digest plist 同名注释），复用与 weekly 相同的 python 二进制 → TCC 授权无需再操作。
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.xlbd.scholar-confirm</string>

    <key>ProgramArguments</key>
    <array>
        <string>__PYTHON_BIN__</string>
        <string>scripts/auto_triage.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__REPO_ROOT__</string>

    <key>EnvironmentVariables</key>
    <dict>
        <!-- 绕开本机代理，同 com.xlbd.scholar-weekly-ingest（入库子进程会用本地 Ollama） -->
        <key>no_proxy</key>
        <string>localhost,127.0.0.1,::1</string>
        <key>NO_PROXY</key>
        <string>localhost,127.0.0.1,::1</string>
        <!-- claude CLI 在 /opt/homebrew/bin；入库子进程的精读回退链要用（见 weekly-ingest 同名注释） -->
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>PYTHONPATH</key>
        <string>__REPO_ROOT__</string>
    </dict>

    <!-- 每天 10:00（睡眠错过会在唤醒后补跑） -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>10</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>__LOG_DIR__/cron_confirm.log</string>
    <key>StandardErrorPath</key>
    <string>__LOG_DIR__/cron_confirm.err.log</string>
</dict>
</plist>
