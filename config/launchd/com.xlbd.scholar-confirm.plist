<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  入库确认（可信度加固 WO-8a，设计 §12.1）：每天 10:00 检查有没有待确认的论文，
  有就先发系统通知、再弹原生对话框（osascript）请用户逐篇勾选；确认后对相应自然周调用
  ingest_notes.py 入库+精读。无人应答（10 分钟）/ 取消 / 无图形会话 → 全部挂起，
  不入库、不精读，明天同一时间再提醒，直到确认。

  为什么是新 job 而不是复用 com.xlbd.scholar-weekly-ingest（周一 09:30）：
  - 「每天提醒一次直到确认」需要每天触发；周度 ingest 只在周一跑，且它的窗口是「本自然周」，
    上周没确认完的条目下周一就不会再被它看到。
  - 周度 ingest 本身保持不动也无害：它现在默认过入库确认闸门，只放行已确认的论文
    （没确认的它只发一条通知）。装了本 job 之后，它基本是个兜底的空跑。
  - 10:00 而非 09:15：digest 平均 6 分钟但长度浮动；队列构建要求 digest 的 stats.json 已生成，
    没跑完的 run 次日再入队，不会漏。

  由 scripts/install_confirm.sh 安装：占位符 __REPO_ROOT__ / __PYTHON_BIN__ / __LOG_DIR__
  会被替换后拷入 ~/Library/LaunchAgents/。弹窗需要登录的图形会话；launchd 用户代理天然在其中。
  复用与 weekly 相同的 python 二进制 → TCC 完全磁盘访问授权无需再操作。
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.xlbd.scholar-confirm</string>

    <key>ProgramArguments</key>
    <array>
        <string>__PYTHON_BIN__</string>
        <string>scripts/confirm_ingest.py</string>
        <string>--daily</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__REPO_ROOT__</string>

    <key>EnvironmentVariables</key>
    <dict>
        <!-- 绕开本机代理，同 com.xlbd.scholar-weekly-ingest（入库子进程会用本地 Ollama） -->
        <key>no_proxy</key>
        <string>localhost,127.0.0.1,::1</string>
        <key>NO_PROXY</key>
        <string>localhost,127.0.0.1,::1</string>
        <!-- claude CLI 在 /opt/homebrew/bin；入库子进程的精读回退链要用（见 weekly-ingest 同名注释） -->
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>PYTHONPATH</key>
        <string>__REPO_ROOT__</string>
    </dict>

    <!-- 每天 10:00（睡眠错过会在唤醒后补跑） -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>10</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>__LOG_DIR__/cron_confirm.log</string>
    <key>StandardErrorPath</key>
    <string>__LOG_DIR__/cron_confirm.err.log</string>
</dict>
</plist>
