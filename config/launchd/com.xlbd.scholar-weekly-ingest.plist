<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  周度入库：把周一 09:00 那轮 digest 判过的论文接上「精读 → 周札记」。

  为什么是独立 job 而不是接在 digest 后面：
  - digest 平均跑 6 分钟且长度随邮件量浮动，写死 sleep 不可靠；
  - 入库失败（精读 API 欠费、Crossref 超时）不该把 digest 的产出一起标成失败；
  - 分开后可以单独重跑入库而不重抓邮件、不重跑 LLM 筛选。
  09:30 起跑，留 30 分钟余量；digest 若还没跑完，本轮读到的是上一轮的窗口，
  下周会补上（跨库去重保证不重复）。

  auto 开关 = 本周 digest 入选的全部入库。想人工挑就别用这个 job，手动跑
  ingest_notes.py 的 list / pick 模式（参数名前加双连字符；XML 注释里写不了
  字面双连字符，见 ingest_notes.py -h）。

  安装：cp 到 ~/Library/LaunchAgents/ 后 launchctl load -w。
  注意仓库在 ~/Documents 下受 TCC 保护，python 二进制需已在「完全磁盘访问权限」中授权
  （com.xlbd.scholar-digest 用的是同一个解释器，已授权则无需再操作）。
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.xlbd.scholar-weekly-ingest</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/xiaolibird/miniconda3/envs/env002_reader/bin/python3.12</string>
        <string>scripts/ingest_notes.py</string>
        <string>--auto</string>
        <string>--top-n</string>
        <string>5</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/xiaolibird/Documents/GitHub/XLBDTranslator-dev</string>

    <key>EnvironmentVariables</key>
    <dict>
        <!-- ⚠️ 绕开本机代理：macOS 系统代理开着时（如 Clash 的 127.0.0.1:7890），
             httpx 经 urllib.request.getproxies() 读到系统设置，会把 http://localhost:11434
             也送进代理，Clash 对本地地址回 502 → 本机 Ollama 一律不可用。
             交互 shell 通常已有 no_proxy 所以手跑没事，launchd 干净环境没有，
             于是「手动能跑、定时永远挂」（curl 不读系统代理，用 curl 探活会误报健康）。
             本 job 会用到本地 Ollama：LLM__FALLBACK_PROVIDERS=ollama 的回退，
             以及 sync_store 的 bge-m3 嵌入。2026-08-16 实测并修。 -->
        <key>no_proxy</key>
        <string>localhost,127.0.0.1,::1</string>
        <key>NO_PROXY</key>
        <string>localhost,127.0.0.1,::1</string>
        <!-- ⚠️ launchd 默认 PATH 不含 /opt/homebrew/bin，claude CLI 在那里——
             缺了它 claude-agent provider 静默跳过、回退链落到 gemini 兜底
             （2026-08-31 周一 09:00 实跑抓到：交互 shell 探活正常、launchd 永远降级，
             与上面 no_proxy 是同一类「手动能跑、定时退化」坑）。
             另：claude CLI 的登录态还硬依赖 USER 变量（按 account=$USER 读 login
             Keychain 的凭据），launchd gui 域自动提供 HOME/USER/LOGNAME/TMPDIR，
             所以不用显式设；但迁 system domain 或裁剪 env 会以 loggedIn:false
             静默挂（2026-08-31 审计洁净环境二分实测）。 -->
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>PYTHONPATH</key>
        <string>/Users/xiaolibird/Documents/GitHub/XLBDTranslator-dev</string>
    </dict>

    <!-- 每周一 09:30（digest 09:00 之后） -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>1</integer>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/xiaolibird/Library/Logs/xlbd-scholar-digest/cron_ingest.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/xiaolibird/Library/Logs/xlbd-scholar-digest/cron_ingest.err.log</string>
</dict>
</plist>
