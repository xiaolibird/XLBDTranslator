# ==========================================
# XLBD Translator - 环境配置文件
# ==========================================
# 配置格式: SECTION__KEY=VALUE
# 修改后需要重启程序才能生效

# ==========================================
# 🚀 快速配置示例
# ==========================================

# 示例 1: 使用 Gemini (推荐新手)
# API__TRANSLATOR_PROVIDER=gemini
# API__GEMINI_API_KEY=AIzaSy...
# API__GEMINI_MODEL=gemini-2.5-flash

# 示例 2: 使用 DeepSeek (高性价比)
# API__TRANSLATOR_PROVIDER=openai-compatible
# API__OPENAI_API_KEY=sk-...
# API__OPENAI_BASE_URL=https://api.deepseek.com
# API__OPENAI_MODEL=deepseek-v4-flash
# PROCESSING__REQUEST_TIMEOUT=120     # DeepSeek响应较慢，增加超时
# PROCESSING__ASYNC_MAX_WORKERS=3     # 降低并发避免限流
# PROCESSING__RATE_LIMIT_DELAY=2.0    # 增加请求间隔

# 示例 3: 使用 OpenAI
# API__TRANSLATOR_PROVIDER=openai-compatible
# API__OPENAI_API_KEY=sk-...
# API__OPENAI_BASE_URL=https://api.openai.com/v1
# API__OPENAI_MODEL=gpt-4o-mini

# 示例 4: 使用本地 Ollama
# API__TRANSLATOR_PROVIDER=openai-compatible
# API__OPENAI_API_KEY=dummy_key
# API__OPENAI_BASE_URL=http://localhost:11434/v1
# API__OPENAI_MODEL=qwen2.5:7b

# ==========================================
# 翻译引擎选择 (必须配置)
# ==========================================

# 翻译引擎提供商
# 可选值:
#   - deepseek: DeepSeek API（本项目默认主力，长文本优化）
#   - gemini: Google Gemini API
#   - openai / openai-compatible / ollama: OpenAI 兼容接口
#   - claude-agent: 本机 claude CLI（订阅计费，建议只作兜底）
API__TRANSLATOR_PROVIDER=deepseek

# 回退供应商链（逗号分隔，可选）
# 说明: 主 provider 欠费(402)/认证失败(401/403)/模型下线(404)/配额连续耗尽(429)
#       时自动切换到链中下一个，无需人工干预
# 可选值: gemini / deepseek / openai-compatible / claude-agent
#   claude-agent = 本机 claude CLI headless（Claude 订阅计费，无需 API key，
#                  token 成本高于 API 直翻，建议只作最后兜底）
# 示例: API__FALLBACK_PROVIDERS=claude-agent
#       API__FALLBACK_PROVIDERS=gemini,claude-agent
# API__FALLBACK_PROVIDERS=claude-agent

# claude-agent 使用的模型别名 (sonnet/opus/haiku)
# API__AGENT_MODEL=sonnet

# ==========================================
# 1. Google Gemini 配置 (推荐)
# ==========================================
# 使用方法: 设置 API__TRANSLATOR_PROVIDER=gemini
# 优势: 质量最高，视觉模式支持，缓存优化
# 成本: 中等 (有免费额度)

# Gemini API 密钥
# 获取地址: https://aistudio.google.com/app/apikey
# 格式: 以 "AIzaSy" 开头的字符串
API__GEMINI_API_KEY=your_gemini_api_key_here

# Gemini 模型选择
# 说明: 模型代际更新快，模板不维护硬编码清单——运行 `python check_models.py`
#       查看你的 key 当前可用的模型（2026-08 时点在用: gemini-3.5-flash）
API__GEMINI_MODEL=gemini-3.5-flash

# ==========================================
# 2. DeepSeek 配置 (高性价比，本项目默认主力 provider)
# ==========================================
# 使用方法: 设置 API__TRANSLATOR_PROVIDER=openai-compatible
# 优势: 成本极低，自动启用长文本优化模式
# 劣势: 响应较慢，可能有速率限制
# 适用: 大量文本翻译，学术文档
#
# ⚠️ 三选一提醒: DeepSeek / OpenAI / Ollama 三段共用
# API__OPENAI_API_KEY / API__OPENAI_BASE_URL / API__OPENAI_MODEL 这三个键名，
# dotenv 加载时后出现的赋值会覆盖前面的（不是分段隔离的）。
# 本段默认保持激活；如需改用 OpenAI 或 Ollama，请先注释掉本段，
# 再取消对应段落的注释，避免配置互相覆盖。

# DeepSeek API Key
# 获取地址: https://platform.deepseek.com/
API__OPENAI_API_KEY=your_deepseek_api_key_here

# DeepSeek Base URL (固定)
API__OPENAI_BASE_URL=https://api.deepseek.com

# DeepSeek 模型选择
# 说明: deepseek-chat 已下线；当前可用 deepseek-v4-flash / deepseek-v4-pro
#       （以 https://platform.deepseek.com 文档为准）
API__OPENAI_MODEL=deepseek-v4-flash

# ==========================================
# DeepSeek 性能优化 (重要!)
# ==========================================
# DeepSeek响应较慢，建议调整以下参数避免超时:

# 增加请求超时时间 (DeepSeek响应较慢)
# PROCESSING__REQUEST_TIMEOUT=120

# 降低异步并发数 (避免触发速率限制)
# PROCESSING__ASYNC_MAX_WORKERS=3

# 增加请求间隔 (减少限流风险)
# PROCESSING__RATE_LIMIT_DELAY=2.0

# ==========================================
# 3. OpenAI 配置 (商业级)
# ==========================================
# 使用方法: 设置 API__TRANSLATOR_PROVIDER=openai-compatible
# 优势: 业界标准，质量稳定
# 成本: 较高
#
# ⚠️ 三选一：启用本段前请先注释掉上面 DeepSeek 段（以及下面 Ollama 段）的
# API__OPENAI_API_KEY / API__OPENAI_BASE_URL / API__OPENAI_MODEL，
# 三段同名键 dotenv 后者覆盖前者，同时激活会导致配置互相覆盖。

# OpenAI API Key
# 获取地址: https://platform.openai.com/
# API__OPENAI_API_KEY=your_openai_api_key_here

# OpenAI Base URL (固定)
# API__OPENAI_BASE_URL=https://api.openai.com/v1

# OpenAI 模型选择
# 可选值:
#   - gpt-4o: 最强多模态模型
#   - gpt-4o-mini: 轻量版，性价比高 (推荐)
#   - gpt-4-turbo: 快速版
# API__OPENAI_MODEL=gpt-4o-mini

# ==========================================
# 4. Ollama 本地配置 (免费离线)
# ==========================================
# 使用方法: 设置 API__TRANSLATOR_PROVIDER=openai-compatible
# 优势: 完全免费，无网络依赖
# 劣势: 需要本地硬件支持，速度较慢
# 安装: https://ollama.com/
#
# ⚠️ 三选一：启用本段前请先注释掉上面 DeepSeek 段（以及 OpenAI 段）的
# API__OPENAI_API_KEY / API__OPENAI_BASE_URL / API__OPENAI_MODEL，
# 三段同名键 dotenv 后者覆盖前者，同时激活会导致配置互相覆盖。

# Ollama API Key (本地无需密钥，留空即可)
# API__OPENAI_API_KEY=

# Ollama 本地服务地址
# API__OPENAI_BASE_URL=http://localhost:11434/v1

# Ollama 模型选择
# 首先安装模型: ollama pull <model_name>
# 推荐模型 (按质量排序):
#   - qwen2.5:14b: 阿里通义千问，中文优秀，学术能力强 (推荐)
#   - llama3.2:3b: Meta Llama，轻量快速
#   - mistral:7b: 优秀开源模型
#   - gemma2:9b: Google Gemma
# 查看已安装: ollama list
# API__OPENAI_MODEL=qwen2.5:14b

# ==========================================
# Ollama 性能优化建议 (重要!)
# ==========================================
# 本地模型受限于硬件，建议按以下配置优化:

# 内存 8GB 以下设备:
#   - 模型: llama3.2:1b 或 gemma2:2b (超轻量)
#   - 批次大小: 1-2
#   - 上下文长度: 512-1024
#   - 异步并发: 1 (单线程)

# 内存 16GB 设备 (如 M1/M2 Mac):
#   - 模型: qwen2.5:7b 或 llama3.2:3b
#   - 批次大小: 2-3
#   - 上下文长度: 1024-2048
#   - 异步并发: 2

# 内存 32GB+ 设备:
#   - 模型: qwen2.5:14b 或 llama3.2:3b
#   - 批次大小: 3-5
#   - 上下文长度: 2048-4096
#   - 异步并发: 4-6

# 内存 64GB+ 高端设备:
#   - 模型: qwen2.5:32b 或 llama3:70b
#   - 批次大小: 5-8
#   - 上下文长度: 4096-8192
#   - 异步并发: 8-10

# 通用优化参数 (在 PROCESSING 部分设置):
# PROCESSING__BATCH_SIZE=2          # 小批次减少内存压力
# PROCESSING__MAX_CONTEXT_LENGTH=1024  # 短上下文
# PROCESSING__ASYNC_MAX_WORKERS=1   # 单线程避免资源竞争
# PROCESSING__ENABLE_GEMINI_CACHING=false  # 关闭缓存节省内存

# ==========================================
# 文件路径配置
# ==========================================

# 待翻译文档的绝对路径
# 说明: 支持 PDF 和 EPUB 格式
# 取值: 完整文件路径 (推荐使用绝对路径)
# 示例: /Users/username/Documents/book.pdf
FILES__DOCUMENT_PATH=/path/to/your/document.pdf

# 输出目录
# 说明: 项目缓存和中间文件的存放位置
# 取值: 相对路径或绝对路径
# 默认: output (在项目根目录下创建)
FILES__OUTPUT_BASE_DIR=output

# 最终翻译文件输出目录 (可选)
# 说明: 翻译完成的 Markdown 和 PDF 存放位置
# 取值: 相对路径或绝对路径
# 默认: 用户的下载文件夹
# FILES__FINAL_OUTPUT_DIR=./final_translations

# 日志文件路径
# 说明: 记录翻译过程的详细日志
# 取值: 相对路径或绝对路径
# 默认: logs/[文档名].log
FILES__LOG_FILE=logs/translation.log

# 翻译模式配置文件路径
# 说明: 定义不同翻译模式的 JSON 配置
# 取值: 相对路径或绝对路径
# 默认: config/modes.json (通常无需修改)
FILES__MODES_CONFIG_PATH=config/modes.json

# ==========================================
# 处理与性能配置
# ==========================================

# 翻译模式
# 说明: 选择预定义的翻译风格和人格（与 config/modes.json 保持同步）
# 可选值:
#   1 = Continental Philosophy (大陆哲学，按流派定译)
#   2 = Biography & History (传记与历史)
#   3 = Critical Theory (批判理论/齐泽克，含译注规范)
#   4 = AI & Data Science (AI 与数据科学)
#   5 = Novel & Fiction (小说)
#   6 = Nietzsche Specialist (尼采专家)
#   7 = Digest Mode (压缩摘要)
#   8 = Logic Analyst (逻辑分析)
# PROCESSING__TRANSLATION_MODE=8

# 批次大小
# 说明: 每次发送给 API 的片段数量
# 取值: 1-10
# 推荐:
#   - 1-3: 高质量翻译，速度慢
#   - 5: 平衡模式 (默认推荐)
#   - 8-10: 快速翻译，质量略降
# 影响: 数值越大速度越快，但单次失败损失越大
PROCESSING__BATCH_SIZE=5

# 上下文窗口长度
# 说明: 翻译时参考的前文字符数
# 取值: 512-8192
# 推荐:
#   - 1024: 短篇文章 (默认)
#   - 2048-4096: 中长篇文章
#   - 8192: 学术书籍 (需要更多上下文)
# 影响: 越大翻译连贯性越好，但 API 成本越高
PROCESSING__MAX_CONTEXT_LENGTH=2048

# 最大重试次数
# 说明: API 调用失败后的最大重试次数
# 取值: 1-10
# 默认: 3
# 影响: 网络不稳定时建议增大
PROCESSING__MAX_RETRIES=3

# 请求超时时间 (秒)
# 说明: 单次 API 请求的最长等待时间
# 取值: 30-300
# 默认: 60
# 推荐:
#   - 60: 一般文档
#   - 120: 复杂学术文档
#   - 180: 图表密集的文档
PROCESSING__REQUEST_TIMEOUT=120

# API 调用间隔 (秒)
# 说明: 文本翻译请求之间的等待时间
# 取值: 0.1-5.0
# 默认: 1.0
# 影响: 防止触发速率限制，过小可能被限流
PROCESSING__RATE_LIMIT_DELAY=1.0

# 视觉模式 API 调用间隔 (秒)
# 说明: 图片翻译请求之间的等待时间
# 取值: 1.0-10.0
# 默认: 2.0
# 影响: 视觉 API 限流更严格，建议保持默认
PROCESSING__VISION_RATE_LIMIT_DELAY=2.0

# 最大文本块大小 (字符)
# 说明: 单个翻译片段的最大字符数
# 取值: 1000-5000
# 默认: 2000
# 影响: 过大可能导致 JSON 截断
PROCESSING__MAX_CHUNK_SIZE=2000

# 启用文档结构缓存 (structure_map.json)
# 说明: 是否保存文档的章节结构和分段信息到缓存文件
# 功能: 避免重复解析PDF/EPUB，加速重启后的文档加载
# 可选值: True / False
# 默认: True (强烈推荐开启)
# 影响: 关闭后每次启动都需要重新解析整个文档结构 (PDF可能需要几分钟)
# 注意: 此缓存与"断点续传"无关，是文档解析阶段的优化
PROCESSING__ENABLE_CACHE=True

# 使用面包屑导航
# 说明: 在翻译时显示当前章节路径 (如: Chapter 1 > Section 1.1)
# 可选值: True / False
# 默认: False
# 影响: 开启后可能增加 Token 消耗
PROCESSING__USE_BREADCRUMB=False

# 渲染页码标记
# 说明: 在 Markdown 输出中显示页码注释
# 可选值: True / False
# 默认: True
# 影响: 方便定位原文位置
PROCESSING__RENDER_PAGE_MARKERS=True

# 使用视觉模式 (实验性)
# 说明: 对图片使用 Gemini Vision API 进行翻译
# 可选值: True / False
# 默认: False
# 影响: 开启后可翻译图表文字，但成本显著增加
# PROCESSING__USE_VISION_MODE=True

# 保留原文
# 说明: 在翻译结果中保留英文原文
# 可选值: True / False
# 默认: False
# 影响: 开启后输出双语对照格式
PROCESSING__RETAIN_ORIGINAL=False

# ==========================================
# API 生成参数
# ==========================================

# 生成温度 (0.0-2.0)。翻译任务推荐 0.1-0.3
PROCESSING__TEMPERATURE=0.2

# Top-P 核采样 (0.0-1.0)。翻译任务推荐 0.9-0.95
PROCESSING__TOP_P=0.95

# Top-K (可选，不设置则由模型决定)
# PROCESSING__TOP_K=40

# 单次调用最大输出 token（过小会截断长段落，过大部分模型会 400）
PROCESSING__MAX_OUTPUT_TOKENS=16384

# ==========================================
# 术语表配置 (Glossary) —— 直接决定全书术语一致性与预翻译成本
# ==========================================

# 预翻译比例：用于建术语表的段落占比 (0.05-0.3)
PROCESSING__GLOSSARY_PREAMBLE_RATIO=0.1

# 已有 glossary.json 时跳过预翻译（省时省钱）
PROCESSING__SKIP_PRETRANSLATE_IF_GLOSSARY_EXISTS=True

# 渐进式术语提取：每个预翻译批后提取并判断饱和，饱和即提前停止
PROCESSING__ENABLE_PROGRESSIVE_GLOSSARY=True

# 饱和度阈值 (0.5-1.0)，越低越早停
PROCESSING__GLOSSARY_STOP_THRESHOLD=0.8

# 术语表最小/最大条目数
PROCESSING__GLOSSARY_MIN_TERMS=10
PROCESSING__GLOSSARY_MAX_TERMS=100

# 生成术语表后暂停等待手动编辑
PROCESSING__ENABLE_GLOSSARY_EDIT=False

# 正式翻译阶段是否用完整术语表重译预翻译段（保证术语一致；
# 已完成的段落不会被重复重译）
PROCESSING__REPROCESS_PRETRANSLATED=True

# ==========================================
# 高级优化配置 (新功能)
# ==========================================

# 启用异步翻译
# 说明: 使用多线程并发翻译，理论速度提升 4 倍
# 可选值: True / False
# 默认: True (大文档自动启用)
# 影响: 关闭后使用同步模式 (更稳定但慢)
PROCESSING__ENABLE_ASYNC=True

# 异步模式启用阈值
# 说明: 待翻译片段数超过此值时启用异步
# 取值: 5-50
# 默认: 10
# 推荐: 10-20 (小文档用同步，大文档用异步)
PROCESSING__ASYNC_THRESHOLD=5

# 异步最大并发数
# 说明: 异步模式下同时运行的线程数
# 取值: 1-20
# 默认: 10
# 推荐:
#   - 5-8: 网络不稳定时
#   - 10: 平衡模式 (默认)
#   - 15-20: 高速网络 (可能触发限流)
# 影响: 过大可能触发 API 速率限制
PROCESSING__ASYNC_MAX_WORKERS=5

# 启用翻译进度断点续传 (checkpoint.json)
# 说明: 实时保存每个片段的翻译进度和状态
# 功能: 翻译中断 (网络断开/程序崩溃/手动停止) 后，重启可从上次位置继续
# 可选值: True / False
# 默认: True (强烈推荐开启)
# 影响: 关闭后中断即需重头翻译，浪费已消耗的API额度
# 注意: 此功能是"翻译阶段"的进度保存，与文档结构缓存不同
PROCESSING__ENABLE_CHECKPOINT=True

# 检查点保存间隔
# 说明: 每隔多少个批次保存一次进度
# 取值: 1-10
# 默认: 1 (每批都保存，最安全)
# 推荐: 1-2
# 影响: 越大保存次数越少，但中断损失越大
PROCESSING__CHECKPOINT_INTERVAL=1

# 启用 Gemini Context Caching
# 说明: 缓存系统指令和术语表，节省 60% 成本
# 可选值: True / False
# 默认: True (强烈推荐开启)
# 影响: 关闭后每次请求都发送完整指令 (成本高)
PROCESSING__ENABLE_GEMINI_CACHING=True

# Gemini 缓存有效期 (小时)
# 说明: 缓存内容的保存时长
# 取值: 1-24
# 默认: 1
# 推荐: 1-2 (Gemini 免费缓存上限 1 小时)
# 影响: 超时后需重新创建缓存
PROCESSING__CACHE_TTL_HOURS=1

# 使用 Rich 美化进度条
# 说明: 显示彩色动态进度条 (需要安装 rich 库)
# 可选值: True / False
# 默认: True (未安装 rich 时自动回退 tqdm)
# 影响: 更好看的界面，无功能差异
PROCESSING__USE_RICH_PROGRESS=True

# ==========================================
# 日志配置
# ==========================================

# 日志级别
# 说明: 控制日志详细程度
# 可选值:
#   - DEBUG: 最详细 (调试时使用)
#   - INFO: 一般信息 (默认推荐)
#   - WARNING: 仅警告和错误
#   - ERROR: 仅错误
# 默认: INFO
LOGGING__LOG_LEVEL=INFO

# ==========================================
# 文档特定配置 (PDF 裁切边距)
# ==========================================

# 上边距裁切比例
# 说明: 裁掉 PDF 页面顶部的页眉/页码
# 取值: 0.0-0.3 (0 = 不裁切, 0.3 = 裁掉 30%)
# 默认: 0.10 (裁掉 10%)
DOCUMENT__MARGIN_TOP=0.10

# 下边距裁切比例
# 说明: 裁掉 PDF 页面底部的页脚/页码
# 取值: 0.0-0.3
# 默认: 0.08
DOCUMENT__MARGIN_BOTTOM=0.08

# 左边距裁切比例
# 说明: 裁掉 PDF 页面左侧空白
# 取值: 0.0-0.2
# 默认: 0.05
DOCUMENT__MARGIN_LEFT=0.05

# 右边距裁切比例
# 说明: 裁掉 PDF 页面右侧空白
# 取值: 0.0-0.2
# 默认: 0.05
DOCUMENT__MARGIN_RIGHT=0.05

# 页码范围 (可选)
# 说明: 只翻译指定页码范围
# 格式:
#   - JSON 数组: "[10, 50]" (第 10-50 页)
#   - 逗号分隔: "1,30" (第 1 页和第 30 页)
# 默认: 不设置 (翻译全部页面)
# DOCUMENT__PAGE_RANGE="[10, 50]"
# DOCUMENT__PAGE_RANGE="1,30"

# 自定义目录文件路径 (可选)
# 说明: 使用外部 CSV 文件定义章节结构
# 取值: CSV 文件路径
# 格式: page,chapter_title
# 示例: 1,Introduction
# 默认: 不设置 (自动检测章节)
# DOCUMENT__CUSTOM_TOC_PATH=./test/test_toc.csv

# ==========================================
# ⚙️ 配置检查清单
# ==========================================

# 1. 选择翻译引擎并配置对应参数
#    ✅ 设置 API__TRANSLATOR_PROVIDER
#    ✅ 配置对应引擎的 API_KEY, BASE_URL, MODEL

# 2. 设置文档路径
#    ✅ 设置 FILES__DOCUMENT_PATH 为你的PDF/EPUB文件路径

# 3. 根据硬件调整性能参数
#    🔧 小内存设备 (8GB): 减小批次大小，关闭缓存
#    🔧 大内存设备 (32GB+): 可增大并发数和上下文长度

# 4. 验证配置
#    🧪 运行: python main.py --config your_config.env
#    📝 检查日志输出确认引擎检测正确

# ==========================================
# 💡 使用建议
# ==========================================

# 初次使用推荐:
# - Gemini 2.5 Flash: 质量与速度平衡，免费额度充足
# - 批次大小 5，上下文长度 1024

# 大量翻译推荐:
# - DeepSeek Chat: 成本极低，长文本优化
#   * 必须设置: PROCESSING__REQUEST_TIMEOUT=120
#   * 建议设置: PROCESSING__ASYNC_MAX_WORKERS=3
#   * 建议设置: PROCESSING__RATE_LIMIT_DELAY=2.0
# - 批次大小 8-10，上下文长度 2048

# 离线使用推荐:
# - Ollama + Qwen2.5: 中文优秀，完全免费
# - 根据硬件调整参数，避免内存不足

# 学术文档推荐:
# - Gemini 2.5 Pro 或 GPT-4o: 复杂推理能力强
# - 启用缓存，增大上下文长度