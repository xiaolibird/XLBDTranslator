# ============================================================
# XLBDTranslator .gitignore
# 原则：代码、配置模板、文档、skill、测试进仓库；运行产物、缓存、密钥、本地环境不进。
# 运行产物统一在 output/（位置约定见 docs/skills/OUTPUTS.md）。
# ============================================================

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
*.egg
.eggs/
.installed.cfg
MANIFEST
build/
develop-eggs/
dist/
downloads/
eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/

# ---------- 虚拟环境 ----------
venv/
env/
ENV/
env.bak/
venv.bak/
.venv/
env002_reader/
.conda_env

# ---------- 密钥与本机配置（只提交 *.template） ----------
.env
.env.local
.env.*.local
config/config.env
config/scholar.env
config/credentials.json
config/token*.json

# ---------- 运行产物 ----------
output/
logs/
test_output/
*.log
# deep-research skill 默认在仓库根落盘；产物统一收进 output/scholar_notes/deep_research/
/reports/
/research_notes/

# 翻译中间文件（正常都在 output/ 下，这里兜住散落在别处的）
**/page_images/
**/Full_Book.md
**/structure_map.json
**/checkpoint.json
**/cache_glossary.json
**/cache_metadata.json
**/glossary.json
**/*.cropped.jpg

# ---------- 测试：白名单结构 ----------
# 目录排除（test/）会阻止 git 进入目录，负向规则必须配合 test/* 才生效
test/*
!test/*.py
!test/data/
!test/fixtures/
!test/test_toc.csv
!test/test_pdf.pdf
!test/test.epub
.pytest_cache/
.coverage

# ---------- 文档 ----------
# docs/ 默认全部进仓库；早期翻译器设计笔记留在本地、不入库
docs/_legacy/

# ---------- 脚本 ----------
# 根目录等处的临时 shell 脚本不入库；正式脚本只放 scripts/ 与各 skill 目录
*.sh
!scripts/*.sh
!docs/skills/**/*.sh
# 下划线开头的是一次性草稿脚本
scripts/_*.py

# ---------- 前端（独立开发，不在本仓库维护） ----------
web/
web-next/

# ---------- Jupyter ----------
.ipynb_checkpoints/
*.ipynb

# ---------- 缓存 ----------
cache/
*.cache
.cache/
.ruff_cache/

# ---------- 编辑器 / agent 本地状态 ----------
.vscode/
.idea/
*.swp
*.swo
*~
.claude/

# ---------- 系统与临时文件 ----------
.DS_Store
Thumbs.db
*.bak
*.backup
*.tmp
*.temp
